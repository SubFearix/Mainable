section .data
; Пример массива чисел (можно заменить на свои данные)
nums dd 123, 4567, 89, -12345, 42, 100000, 7, 998, 999, 1000, 399999999
nums_len equ ($ - nums) / 4 ; Количество элементов в массиве

section .text
global _start

_start:
    mov esi, nums ; Указатель на начало массива
    mov ecx, nums_len ; Количество элементов в массиве
    xor edi, edi ; Счетчик чисел с нечетным количеством цифр (обнуляем)

process_number:
    push rcx ; Сохраняем счетчик цикла в стеке
    lodsd ; Загружаем текущее число в eax
    test eax, eax ; Проверяем, является ли число отрицательным
    jns count_digits ; Если не отрицательное, переходим к подсчету цифр
    neg eax ; Если отрицательное, делаем его положительным

count_digits:
    xor ebx, ebx ; Счетчик цифр (обнуляем)
    test eax, eax ; Проверяем, равно ли число нулю
    jnz digit_loop ; Если не ноль, переходим к циклу подсчета
    inc ebx ; Для нуля количество цифр = 1
    jmp check_odd

digit_loop:
    inc ebx ; Увеличиваем счетчик цифр
    xor edx, edx ; Обнуляем edx перед делением
    mov ecx, 10
    div ecx ; Делим число на 10 (eax = eax/10, edx = остаток)
    test eax, eax ; Проверяем, стало ли число нулем
    jnz digit_loop ; Если не ноль, продолжаем цикл

check_odd:
    test ebx, 1 ; Проверяем младший бит счетчика цифр
    jz next_number ; Если четное количество цифр, переходим к следующему числу
    inc edi ; Увеличиваем счетчик чисел с нечетным количеством цифр

next_number:
    pop rcx ; Восстанавливаем счетчик цикла из стека
    loop process_number ; Уменьшаем ecx и переходим к следующему числу, если ecx != 0

    ; Теперь в edi содержится количество чисел с нечетным количеством цифр
    ; Далее можно вывести результат или вернуть его как код завершения
    ; Завершение программы с результатом в edi
    mov eax, 60 ; Системный вызов exit
    mov edi, edi ; Передаем результат как код возврата
    syscall
